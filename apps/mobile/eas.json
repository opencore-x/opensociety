{
  "cli": { "version": ">= 23.2.0", "appVersionSource": "remote" },
  "build": {
    "base": { "node": "22.17.0", "pnpm": "10.0.0" },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "env": { "APP_ENV": "preview" },
      "android": { "buildType": "apk" }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "environment": "production",
      "env": { "APP_ENV": "production" },
      "autoIncrement": true
    },
    "testflight": { "extends": "production" },
    "play-internal": {
      "extends": "production",
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "play-internal": {
      "android": {
        "applicationId": "com.opensociety.app",
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "testflight": { "ios": { "appleTeamId": "H4JB3X394X" } }
  }
}
