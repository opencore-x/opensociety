# Local Node API. Copy to .env and use your development Neon branch.
# This placeholder supports /health but cannot serve database-backed routes.
DATABASE_URL=postgresql://test:test@localhost/test
WEB_ORIGINS=http://localhost:3000,http://localhost:8081
BILLING_ENABLED=false
PUSH_ENABLED=false

# Use the same Clerk instance as the web/mobile client.
# CLERK_SECRET_KEY=sk_test_...
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_WEBHOOK_SECRET=whsec_...

# Optional for local development; required to exercise uploads against R2.
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=opensociety-uploads
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
