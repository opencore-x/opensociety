# Copy to `.env` (gitignored) for local web dev. All web vars must be prefixed
# with VITE_ to be exposed to the client bundle.

# Base URL of the API. Defaults to http://localhost:8787 if unset.
VITE_API_URL=http://localhost:8787

# Enable Clerk sign-in with the same instance used by the API.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Development only: the API accepts this identity only without a Clerk secret.
# Must be a real users.id (uuid) from your database.
# VITE_DEV_USER_ID=00000000-0000-0000-0000-000000000000

# Set for hosting builds to require HTTPS, Clerk, and no development identity.
# DEPLOY_ENV=staging
