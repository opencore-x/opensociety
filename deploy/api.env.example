APP_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/DATABASE?sslmode=require
CLERK_SECRET_KEY=sk_live_REPLACE_ME
CLERK_PUBLISHABLE_KEY=pk_live_REPLACE_ME
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME
WEB_ORIGINS=https://society.example.com
R2_ACCOUNT_ID=REPLACE_ME
R2_BUCKET_NAME=opensociety-uploads
