# Enable only after migrations and bill configuration have been reviewed.
# Startup catches up the current month, then runs at 00:00 UTC on the first.
BILLING_ENABLED=false
# Enable after this app's APNs and FCM setup and a physical-device test.
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
BILL_REMINDER_DAYS=-7,0,3
SOCIETY_TIME_ZONE=Asia/Kolkata
